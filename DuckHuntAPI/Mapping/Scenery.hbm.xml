<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
	namespace="DuckHuntAPI.Models" assembly="DuckHuntAPI">

	<class name="Scenery" table="Scenery">
		<id name="id">
			<column name="Id" sql-type="int" not-null="false"/>
		</id>
		
		<property name="name">
			<column name="Name" length="255"/>
		</property>
		
		<property name="type">
			<column name="Type" length="15"/>
		</property>

		<many-to-one
			not-null="true"
			name="image"
			class="Image"
			column="ImageId"/>
	</class>
</hibernate-mapping>