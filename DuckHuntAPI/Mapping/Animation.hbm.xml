<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
	namespace="DuckHuntAPI.Models" assembly="DuckHuntAPI">
	
	<class name="Animation" table="Animation">
		<id name="Id">
			<column name="Id" sql-type="int" not-null="false"/>
		</id>
		<property name="characterId">
			<column name="CharacterId" sql-type="int"/>
		</property>
		<property name="name">
			<column name="Name" length="255"/>
		</property>
		
		<bag name ="imageSequence"
			 cascade="all-delete-orphan">
			<key column = "AnimationId"/>
			<one-to-many class="ImageSeq"/>
		</bag>
	</class>
</hibernate-mapping>