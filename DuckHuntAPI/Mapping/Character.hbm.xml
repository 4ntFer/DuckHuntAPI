<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
    namespace="DuckHuntAPI.Models" assembly="DuckHuntAPI">

    <class name="Character" table="Character">

        <id name="id">
            <column name="Id" sql-type="int" not-null="false"/>
            <generator class="uuid.hex" />
        </id>

        <property name="name">
            <column name="Name" length="255" not-null="false" />
        </property>
		
		<bag name="characterImages"
			 cascade="all-delete-orphan">
			<key column="CharacterId"/>
			<one-to-many class="CharacterImage"/>
		</bag>
		
		<bag name = "animations"
			 cascade="all-delete-orphan">
			<key column="CharacterId"/>
			<one-to-many class="Animation"/>
		</bag>
    </class>

</hibernate-mapping>