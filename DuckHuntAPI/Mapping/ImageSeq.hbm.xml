<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
    namespace="DuckHuntAPI.Models" assembly="DuckHuntAPI">
    <class name="ImageSeq" table="ImageSequence">

		<id name="id">
			<column name="Id" sql-type="int"/>
		</id>
		
		<property name="animationId">
			<column name ="AnimationId" sql-type="int"/>
		</property>
		
		<property name="imageIndex">
			<column name="ImageIndex" sql-type="int"/>
		</property>
		
		<many-to-one name="image"
					 cascade="all-delete-orphan"
					 column="ImageId"/>
</class>
</hibernate-mapping>