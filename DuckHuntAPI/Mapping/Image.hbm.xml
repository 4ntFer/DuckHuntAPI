<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
    namespace="DuckHuntAPI.Models" assembly="DuckHuntAPI">

	<class name="Image" table="Image">

		<id name="id">
			<column name="Id" sql-type="int" not-null="false"/>
			<generator class="uuid.hex" />
		</id>

		<property name="data">
			<column name="Dado" sql-type="varbinary" not-null="false" />
		</property>
		
		<many-to-one
			not-null="true"
			name="character"
			class="Character"
			column="CharacterId"/>
	</class>

</hibernate-mapping>