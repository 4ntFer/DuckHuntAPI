<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
	namespace="DuckHuntAPI.Security.Models" assembly="DuckHuntAPI">

	<class name="Ban" table="Ban">
		<id name="id">
			<column name="id" sql-type="int" not-null="false"/>
		</id>
		<property name="deviceId">
			<column name="deviceId" sql-type="int"/>
		</property>
		<property name="startTime">
			<column name="startTime" sql-type="datetime"/>
		</property>
		<property name="endTime">
			<column name="endTime" sql-type="datetime"/>
		</property>
	</class>
</hibernate-mapping>